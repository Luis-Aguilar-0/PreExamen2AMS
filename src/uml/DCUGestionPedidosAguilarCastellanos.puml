@startuml
left to right direction

actor "Usuario" as User

rectangle "Sistema de gestion de pedidos" {
    usecase "Registrar informacion usuario" as UC1
    usecase "Validacion de credenciales" as UC2
    usecase "Visualizacion de catalogo de productos" as UC3
    usecase "Creación de pedidos" as UC4
    usecase "Consulta transacciones de usuario" as UC5
    
}

'REALACION DEL USUARIO CON EL SITEMA'

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5

UC1 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>
UC5 ..> UC2 : <<include>>

@enduml
